<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 draws this on a 288dp canvas masked to a ~192dp circle.
     A fixed 288dp transparent base stops the system from scaling the logo up;
     the logo sits well inside the circle so it is never cropped. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="90dp"
        android:height="60dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
